{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. No shell, no fs, no http; the opener only accepts the About page links.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://zsync.eu"
        },
        {
          "url": "https://zsync.eu/zpassword-desktop"
        },
        {
          "url": "https://github.com/theholyonez"
        },
        {
          "url": "https://github.com/theholyonez/zpassword-desktop"
        }
      ]
    }
  ]
}
